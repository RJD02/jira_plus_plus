# Backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jira_plus_plus
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform
TENANT_ID=dev
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="name@example.com"
JIRA_API_TOKEN="your-jira-api-token"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
REPORTING_AGENT_OPENAI_API_KEY="sk-..."
REPORTING_AGENT_OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"
ANTHROPIC_MODEL="claude-3-haiku-20240307"
INSIGHTS_PROVIDER=local
INSIGHTS_CACHE_TTL_MINUTES=720
INSIGHTS_LOCAL_TIMEOUT_MS=180000
ISSUE_INSIGHT_PROVIDER=
ISSUE_INSIGHT_MODEL=
NARRATIVE_PROVIDER=auto
NARRATIVE_MODEL=gpt-4o-mini

# Frontend
VITE_GRAPHQL_ENDPOINT="http://localhost:4000/graphql"
VITE_METADATA_GRAPHQL_ENDPOINT="http://localhost:4010/graphql"
VITE_FEATURE_OVERLAY_ENABLED="false"

# Auth / Security
SESSION_SECRET="please-change-this-session-secret-32-char"
ENCRYPTION_SECRET="please-change-this-encryption-secret-32"
ADMIN_EMAIL="admin@jira-plus-plus.local"
ADMIN_PASSWORD="change-me"
ADMIN_DISPLAY_NAME="Jira++ Admin"
TEMPORAL_ADDRESS="127.0.0.1:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="jira-sync"
REPORTING_TEMPORAL_TASK_QUEUE="reporting"
SYNC_DEFAULT_CRON="*/15 * * * *"
REPORTING_API_ENDPOINT="http://localhost:4002/graphql"
REPORTING_API_TENANT_ID="dev"
METADATA_CLIENT_MODE="local"
METADATA_API_PORT=4010
METADATA_GRAPHQL_ENDPOINT="http://localhost:4010/graphql"
METADATA_STORE_DIR="./metadata/store"
METADATA_DEFAULT_PROJECT="global"
METADATA_SEED_MANIFEST="configs/reporting/catalog.json"
METADATA_SOURCE_SCHEMAS="public"
# METADATA_SOURCE_ENDPOINT_ID="postgres.jira-plus-plus"
# METADATA_SOURCE_ENDPOINT_NAME="Jira++ Postgres"
# METADATA_SOURCE_ENDPOINT_DESCRIPTION="Primary Postgres backing store for Jira++"
METADATA_TEMPORAL_TASK_QUEUE="metadata"
METADATA_COLLECTION_SCRIPT="./platform/spark-ingestion/scripts/run_metadata_job.py"
METADATA_COLLECTION_PYTHON="python3"
# Supply when using Postgres-backed metadata store
# METADATA_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jira_plus_plus?schema=metadata"

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="user@example.com"
SMTP_PASSWORD="app-specific-password"
SMTP_SECURE=false
SMTP_FROM_EMAIL="notifications@example.com"
