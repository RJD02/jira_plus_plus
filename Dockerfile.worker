# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.3 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/prisma apps/api/prisma
COPY tsconfig.base.json ./
COPY packages/cdm/package.json packages/cdm/package.json
COPY packages/clients/package.json packages/clients/package.json
COPY packages/llm-core-runtime/package.json packages/llm-core-runtime/package.json
COPY packages/cdm/prisma packages/cdm/prisma

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @platform/cdm exec -- prisma generate --schema prisma/schema.prisma

FROM base AS build
COPY apps/api apps/api
COPY packages packages
RUN pnpm --filter @jira-plus-plus/api build

FROM node:20-bullseye-slim AS runtime
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl openssl ca-certificates python3 build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@8.15.3 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/api/prisma apps/api/prisma
COPY packages/cdm/package.json packages/cdm/package.json
COPY packages/clients/package.json packages/clients/package.json
COPY packages/llm-core-runtime/package.json packages/llm-core-runtime/package.json
COPY packages/cdm/prisma packages/cdm/prisma
COPY packages packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @platform/cdm exec -- prisma generate --schema prisma/schema.prisma
ENV NODE_ENV=production
COPY --from=build /app/apps/api/dist /app/apps/api/dist

EXPOSE 4001
CMD ["node", "--experimental-specifier-resolution=node", "apps/api/dist/temporal/worker.js"]
