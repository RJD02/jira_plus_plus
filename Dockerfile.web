# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
ARG VITE_GRAPHQL_ENDPOINT="http://localhost:4000/graphql"
ARG VITE_API_BASE_URL="http://localhost:4000"
ARG VITE_KEYCLOAK_BASE_URL=""
ARG VITE_KEYCLOAK_REALM=""
ARG VITE_KEYCLOAK_CLIENT_ID=""
ENV VITE_GRAPHQL_ENDPOINT=$VITE_GRAPHQL_ENDPOINT
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_KEYCLOAK_BASE_URL=$VITE_KEYCLOAK_BASE_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.3 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/jira-plus-plus/package.json apps/jira-plus-plus/package.json
COPY apps/jira-plus-plus/vite.config.ts apps/jira-plus-plus/vite.config.ts
COPY tsconfig.base.json ./

RUN pnpm install --frozen-lockfile --filter @apps/jira-plus-plus...

FROM base AS build
COPY apps/jira-plus-plus apps/jira-plus-plus
# Write .env at envDir (/app) so Vite can read VITE_* vars during build
RUN printf "VITE_GRAPHQL_ENDPOINT=%s\nVITE_API_BASE_URL=%s\nVITE_KEYCLOAK_BASE_URL=%s\nVITE_KEYCLOAK_REALM=%s\nVITE_KEYCLOAK_CLIENT_ID=%s\n" \
  "$VITE_GRAPHQL_ENDPOINT" "$VITE_API_BASE_URL" "$VITE_KEYCLOAK_BASE_URL" "$VITE_KEYCLOAK_REALM" "$VITE_KEYCLOAK_CLIENT_ID" \
  > /app/.env
RUN cat /app/.env
RUN pnpm --filter @apps/jira-plus-plus build

FROM node:20-alpine AS runtime
WORKDIR /app
RUN npm install -g serve
COPY --from=build /app/apps/jira-plus-plus/dist ./dist
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
