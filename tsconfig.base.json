{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@platform/cdm": ["packages/cdm"],
      "@platform/clients": ["packages/clients"],
      "@metadata/query": ["packages/metadata-client/src"],
      "@metadata/client": ["packages/metadata-client/src"],
      "@metadata/core": ["packages/metadata-core/src"],
      "@reporting/catalog": ["packages/reporting-catalog/src"],
      "@reporting/registry": ["packages/reporting-registry/src"],
      "@reporting/sandbox": ["packages/reporting-sandbox/src"],
      "@reporting/temporal": ["packages/reporting-temporal/src"],
      "@reporting/ui-sdk": ["packages/reporting-ui-sdk/src"]
    }
  }
}
