generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
  output          = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["reporting"]
}

model ReportDefinition {
  @@schema("reporting")

  id                   String            @id @default(uuid())
  tenantId             String            @default("dev")
  slug                 String            @unique
  name                 String
  description          String?
  type                 String            @default("QUERY")
  personaTags          String[]
  scopePolicy          Json?
  filterSchema         Json?
  visualisationConfig  Json?
  currentVersionId     String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  versions             ReportVersion[]
  dashboardTiles       DashboardTile[]
  currentVersion       ReportVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([tenantId, slug])
}

model ReportVersion {
  @@schema("reporting")

  id             String          @id @default(uuid())
  definitionId   String
  tenantId       String          @default("dev")
  status         String
  queryTemplate  String?
  defaultFilters Json?
  notes          String?
  createdBy      String?
  createdAt      DateTime        @default(now())
  publishedAt    DateTime?

  definition     ReportDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  runs           ReportRun[]
  dashboardTiles DashboardTile[]
  currentFor     ReportDefinition? @relation("CurrentVersion")

  @@index([tenantId, status])
}

model ReportDashboard {
  @@schema("reporting")

  id               String             @id @default(uuid())
  tenantId         String             @default("dev")
  slug             String             @unique
  name             String
  description      String?
  personaTags      String[]
  currentVersionId String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions         DashboardVersion[]
  currentVersion   DashboardVersion?  @relation("CurrentDashboardVersion", fields: [currentVersionId], references: [id])

  @@index([tenantId, slug])
}

model DashboardVersion {
  @@schema("reporting")

  id            String            @id @default(uuid())
  dashboardId   String
  tenantId      String            @default("dev")
  status        String
  layout        Json
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  dashboard     ReportDashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  tiles         DashboardTile[]
  currentFor    ReportDashboard?  @relation("CurrentDashboardVersion")

  @@index([tenantId, status])
}

model DashboardTile {
  @@schema("reporting")

  id                  String          @id @default(uuid())
  dashboardVersionId  String
  reportDefinitionId  String
  reportVersionId     String?
  tenantId            String          @default("dev")
  position            Json?
  size                Json?
  tileOverrides       Json?

  dashboardVersion    DashboardVersion  @relation(fields: [dashboardVersionId], references: [id], onDelete: Cascade)
  reportDefinition    ReportDefinition  @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  reportVersion       ReportVersion?    @relation(fields: [reportVersionId], references: [id])

  @@index([tenantId])
}

model ReportRun {
  @@schema("reporting")

  id              String         @id @default(uuid())
  reportVersionId String
  tenantId        String         @default("dev")
  executedBy      String?
  executedAt      DateTime       @default(now())
  durationMs      Int            @default(0)
  status          String
  cacheHit        Boolean        @default(false)
  filterHash      String?
  filtersUsed     Json?
  payload         Json?
  error           String?
  workflowId      String?
  temporalRunId   String?

  reportVersion   ReportVersion  @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId, executedAt])
  @@index([tenantId, executedAt])
  @@index([workflowId])
}

model AgentReflection {
  @@schema("reporting")

  id        String        @id @default(uuid())
  tenantId  String        @default("dev")
  userId    String?
  persona   String?
  status    String        @default("ACTIVE")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  AgentMessage[]

  @@index([tenantId, status])
}

model AgentMessage {
  @@schema("reporting")

  id            String   @id @default(uuid())
  reflectionId  String
  role          String
  content       String
  suggestions   Json?
  createdAt     DateTime @default(now())

  reflection    AgentReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  @@index([reflectionId, createdAt])
}
