{
  "name": "@apps/reporting-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "temporal:worker": "dotenv -e ../../.env -- tsx src/temporal/worker.ts"
  },
  "dependencies": {
    "@metadata/client": "workspace:*",
    "@apollo/server": "^4.10.0",
    "@prisma/client": "^5.22.0",
    "@reporting/catalog": "workspace:*",
    "@reporting/registry": "workspace:*",
    "@reporting/sandbox": "workspace:*",
    "@reporting/temporal": "workspace:*",
    "@temporalio/client": "^1.9.3",
    "@temporalio/worker": "^1.9.3",
    "@temporalio/workflow": "^1.9.3",
    "openai": "^4.67.1",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "graphql-scalars": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "prisma": "^5.22.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
